# ThreadCraft Studio — frontend environment (Vite)
# Copy to client/.env for local dev; set the production values in Netlify's
# "Site settings → Environment variables".

# Local dev: Vite's proxy already forwards /api → localhost:5000, so an empty
# value keeps requests same-origin. Set explicitly only when calling a remote API.
VITE_API_URL=

# Production (Netlify): point at the deployed Express API, e.g.
# VITE_API_URL=https://api.your-domain.com
