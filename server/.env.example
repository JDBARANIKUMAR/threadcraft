NODE_ENV=development

PORT=5000

# MongoDB — local dev default below; production must use MongoDB Atlas
# (server refuses to start in production without an explicit MONGO_URI)
MONGO_URI=mongodb://127.0.0.1:27017/threadcraft_custom_tshirts

# REQUIRED in all environments — server refuses to start without it (min 16 chars)
JWT_SECRET=change_me_to_a_long_random_string_min_16_chars
JWT_EXPIRES_IN=7d

# Comma-separated list of trusted frontend origins (production CORS).
# Example: CLIENT_URL=https://threadcraft.netlify.app,https://www.threadcraft.xyz
CLIENT_URL=http://localhost:5173

# Cloudinary (cloud image storage). When all three are set, admin uploads go to
# Cloudinary folders (threadcraft/products, /banners, /designs, ...). When
# omitted, dev falls back to local /uploads. NEVER expose these to the frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay — live payments. Secret + webhook secret stay server-side only.
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Used by `node src/seedAdmin.js` to create the first admin account.
# Password must be at least 8 characters.
ADMIN_EMAIL=admin@threadcraft.com
ADMIN_PASSWORD=change_me_min_8_chars
